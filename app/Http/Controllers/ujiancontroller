            $totalJawaban = count($jawaban_pilgan) + count($jawaban_essay);
        } else {

            $soal_satuan = collect();
            $jawaban_pilgan = collect();
            $jawaban_essay = collect();

            $totalJawaban = count($jawaban_pilgan) + count($jawaban_essay);
        }
        $jumlahSoal = $soal_satuan->lastPage();
        // dd($soal_satuan);
