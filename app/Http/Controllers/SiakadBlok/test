    function daftarmk(Request $r, $id, $sem)
    {
        if (empty($r->o)) {
            $order = 'nama_matakuliah';
        } else {
            $order = $r->o;
        }

        $kelas = DB::table("kelas as a")
            ->select("a.id_kelas", 'b.nama_matakuliah', 'c.nama_kurikulum', 'a.kode_kelas', 'a.jumlah_peserta', 'b.kode_matakuliah', 'd.nama_blok', 'd.tahun as tahun_blok', 'b.sks_total', 'd.id_blok')
            ->leftjoin("matakuliah as b", 'a.id_matakuliah', '=', 'b.id_matakuliah')
            ->leftjoin("kurikulum as c", 'a.id_kurikulum', '=', 'c.id_kurikulum')
            ->leftjoin("siakad_blok.blok as d", 'b.id_blok', '=', 'd.id_blok')
            ->where("sistembl_siakad-uin ", '1')
            ->where("a.id_prodi", $id)
            ->where("a.id_semester", $sem)
            ->wherenull("a.id_kelas_parent")
            ->orderby("b.nama_blok")
            ->orderby("a.id_kelas")
            ->paginate(4000);

        $kelasmerge = DB::table("kelas as a")
            ->wherenotnull("id_kelas_parent")
            ->where("a.id_prodi", $id)
            ->where("a.id_semester", $sem)
            ->get();

        $kelasmerg = array();

        foreach ($kelasmerge as $km) {
            $idparent = $km->id_kelas_parent;
            $id_kelas = $km->id_kelas;
            $kelasmerg[$idparent][] = $km->jumlah_peserta;
        }

        $data = array();

        $data['kelasmerge'] = $kelasmerg;
        $data['kelas'] = $kelas;

        return response()->json($data);
    }

    function update(Request $req)
    {
        $data = array();
        if ($req->sistembl_siakad-uin  == '') {
            $data['sistembl_siakad-uin '] = null;
            $data['nama_blok'] = null;
        } else {
            $data['sistembl_siakad-uin '] = 1;
            $data['nama_blok'] = $req->nama_blok;
        }

        return DB::table("matakuliah")
            ->where("id_matakuliah", $req->id_matakuliah)
            ->update($data);
    }

    function getdatablok(Request $r)
    {
        $jenisblok = DB::table("siakad_blok.mapping_blok_jenisblok as a")
            ->leftjoin("siakad_blok.jenisblok as b", 'a.id_jenis_blok', '=', 'b.id_jenisblok')
            ->where("a.id_blok", $r->id_blok)
            ->orderby("a.nomor_urut")
            ->get();
        $data = array();
        $i = 0;
        foreach ($jenisblok as $jb) {
            $data[$i] = $jb;
            $dosenpengampu = array();
            $kelasblok = DB::table("siakad_blok.kelompok_belajar as b")
                ->select("b.*", DB::raw('(b.id_kelompok_belajar * 0) as dosenpengampu, (b.id_kelompok_belajar * 0) as daftarmahasiswa'))
                ->where("b.id_mapping_jenis_blok", $jb->id)
                ->where("b.id_kelas", $r->id_kelas)
                ->orderby("b.nomor_urut")
                ->orderby("b.nama_kelompok_belajar")
                ->get();

            if (count($kelasblok) > 0) {
                $data[$i]->rombel = $kelasblok;
            } else {
                $data[$i]->rombel = array();
            }
            $i++;
        }

        $datakirim = array();

        $koordinator = DB::table("siakad_blok.koordinator_blok as c")
            ->where("c.id_kelas", $r->id_kelas)
            ->first();

        if ($koordinator) {
            $datakirim['koordinator'] = $koordinator;
        } else {
            $datakirim['koordinator'] = null;
        }

        $datakirim['data'] = $data;

        $datakirim['eid_kelas'] = Crypt::encrypt($r->id_kelas);
        return $datakirim;
    }

