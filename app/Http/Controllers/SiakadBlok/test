    function getdatamahasiswakontrakmk(Request $r)
    {

        if (!$r->showdata) {
            $showdata = 10;
        } else {
            $showdata = $r->showdata;
        }

        if ($r->jenis_blok == 2) {
            $mhs = DB::table('krs as a')
                ->select("c.no_mhs", 'd.nama_mahasiswa', 'c.angkatan', 'b.id_kelas_parent', 'a.id_krs', 'a.id_mhs_pt')
                ->leftjoin('kelas as b', 'a.id_kelas', '=', 'b.id_kelas')
                ->leftjoin('mhs_pt as c', 'a.id_mhs_pt', '=', 'c.id_mhs_pt')
                ->leftjoin('mahasiswa as d', 'd.id_mahasiswa', '=', 'c.id_mahasiswa')
                ->leftjoin("siakad_blok.mahasiswa_rombel as e", function ($join) use ($r) {
                    $join->on("a.id_mhs_pt", '=', 'e.id_mhs_pt')
                        ->where('e.id_kelas', '=', $r->id_kelas)
                        ->where('e.id_jenis_blok', '=', $r->id_jenis_blok);
                })
                ->where(function ($query) use ($r) {
                    $query->where('b.id_kelas', $r->id_kelas)
                        ->orwhere('b.id_kelas_parent', $r->id_kelas);
                })
                // ->wherenull('e.id_mahasiswa_rombel')
                ->groupby("a.id_mhs_pt")
                ->orderby("c.no_mhs")
                ->paginate($showdata);
        } else {
            $mhs = DB::table('krs as a')
                ->select("c.no_mhs", 'd.nama_mahasiswa', 'c.angkatan', 'b.id_kelas_parent', 'a.id_krs', 'a.id_mhs_pt')
                ->leftjoin('kelas as b', 'a.id_kelas', '=', 'b.id_kelas')
                ->leftjoin('mhs_pt as c', 'a.id_mhs_pt', '=', 'c.id_mhs_pt')
                ->leftjoin('mahasiswa as d', 'd.id_mahasiswa', '=', 'c.id_mahasiswa')
                ->leftjoin("siakad_blok.mahasiswa_rombel as e", function ($join) use ($r) {
                    $join->on("a.id_mhs_pt", '=', 'e.id_mhs_pt')
                        ->where('e.id_kelas', '=', $r->id_kelas)
                        ->where('e.id_jenis_blok', '=', $r->id_jenis_blok);
                })
                ->where(function ($query) use ($r) {
                    $query->where('b.id_kelas', $r->id_kelas)
                        ->orwhere('b.id_kelas_parent', $r->id_kelas);
                })
                ->wherenull('e.id_mahasiswa_rombel')
                ->groupby("a.id_mhs_pt")
                ->orderby("c.no_mhs")
                ->paginate($showdata);
        }
        return $mhs;
    }

    function simpanrombelmhs(Request $r)
    {
        $mhsarray = $r->daftar_mhs;

        $datamhs = $r->data_mhs;
        $dd = array();
        $insert = 0;
        $error = 0;
        $update = 0;

        foreach ($datamhs as $d) {
            $id_mhspt = $d['id_mhs_pt'];
            $dd[$id_mhspt]['id_mhs_pt'] = $id_mhspt;
            $dd[$id_mhspt]['no_mhs'] = $d['no_mhs'];
            $dd[$id_mhspt]['nama_mahasiswa'] = $d['nama_mahasiswa'];
            $dd[$id_mhspt]['angkatan'] = $d['angkatan'];
        }

        foreach ($mhsarray as $m) {
            //cek data
            $cekmhs = DB::table("siakad_blok.mahasiswa_rombel as a")
                ->select("a.id_mahasiswa_rombel")
                ->where('a.id_kelas', $r->id_kelas)
                ->where('a.id_jenis_blok', $r->id_jenis_blok)
                ->where('a.id_mhs_pt', $m)
                ->where('a.id_kelompok_belajar', $r->id_kelompok_belajar)
                ->first();

            if (!$cekmhs) {
                if (isset($dd[$m])) {
                    //simpan data ke tabel
                    $data = [
                        'id_kelompok_belajar' => $r->id_kelompok_belajar,
                        'id_kelas' => $r->id_kelas,
                        'id_jenis_blok' => $r->id_jenis_blok,
                        'id_mhs_pt' => $dd[$m]['id_mhs_pt'],
                        'no_mhs' => $dd[$m]['no_mhs'],
                        'nama_mahasiswa' => $dd[$m]['nama_mahasiswa'],
                        'angkatan' => $dd[$m]['angkatan'],
                        'created_at' => date("Y-m-d H:i:s"),
                        'updated_at' => date("Y-m-d H:i:s"),
                    ];

                    $simpan = DB::table("siakad_blok.mahasiswa_rombel")
                        ->insert($data);

                    if ($simpan) {
                        $insert++;
                    } else {
                        $error++;
                    }
                }
            } else {
                $update++;
            }
        }
        return response("ditambahkan = " . $insert . " gagal = " . $error . " sudah terdaftar = " . $update, 200);
    }

