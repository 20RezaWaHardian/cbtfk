    function inputkoordinator(Request $r)
    {
        try {
            $id = Crypt::decrypt($r->eidkelas);
        } catch (DecryptException $e) {
            $id = "";
        }

        if ($id > 0) {
            $cek_data = DB::table('siakad_blok.koordinator_blok')
                ->where('id_kelas', $id)
                ->count();

            $data = array();

            $pegawai = $r->pegawai;

            $data['update_at'] = date("Y-m-d H:i:s");
            $data['id_semester'] = $r->id_semester;

            if ($r->jenis == 1) {
                $data['id_pegawai_koor'] = $pegawai['id_pegawai'];
                $data['data_koor'] = json_encode($pegawai);
            } else {
                $data['id_pegawai_ass'] = $pegawai['id_pegawai'];
                $data['data_ass'] = json_encode($pegawai);
            }


            if ($cek_data > 0) {
                //update
                $simpan = DB::table('siakad_blok.koordinator_blok')
                    ->where('id_kelas', $id)
                    ->update($data);
            } else {
                $data['id_kelas'] = $id;
                $simpan = DB::table('siakad_blok.koordinator_blok')
                    ->insert($data);
            }
        }
        return $simpan;
    }

    function update_rekap($id_pegawai, $id_prodi, $id_semester, $nama)
    {
        $sksdosen = DB::table("siakad_blok.dosen_pengampu as a")
            ->select("a.id_pegawai", 'b.waktu', 'e.pembagi_sks', 'a.nama')
            ->leftjoin("siakad_blok.materi_perkuliahan_rincian as b", 'a.id_materi_perkuliahan_rincian', '=', 'b.id_materi_perkuliahan_rincian')
            ->leftjoin("siakad_blok.kelompok_belajar as c", 'a.id_kelompok_belajar', '=', 'c.id_kelompok_belajar')
            ->leftjoin("kelas as d", 'c.id_kelas', '=', 'd.id_kelas')
            ->leftjoin("siakad_blok.jenisblok as e", 'e.id_jenisblok', '=', 'c.id_jenis_blok')
            ->where('a.id_pegawai', $id_pegawai)
            ->where("a.id_semester", $id_semester)
            ->where("d.id_prodi", $id_prodi)
            ->wherenotnull("e.id_jenisblok")
            ->get();

        $subtotal = 0;
        $jmlhpertemuan = 0;
        foreach ($sksdosen as $vv) {
            echo $vv->nama . "=" . $vv->waktu . "/" . $vv->pembagi_sks . "\n";
            $sksd = $vv->waktu / $vv->pembagi_sks;
            $subtotal += $sksd;
            $jmlhpertemuan++;
        }

        $datasim = array();
        $datasim['id_pegawai'] = $id_pegawai;
        $datasim['nama'] = $nama;
        $datasim['id_prodi'] = $id_prodi;
        $datasim['id_semester'] = $id_semester;
        $datasim['sks_total'] = $subtotal;
        $datasim['Jml_pertemuan'] = $jmlhpertemuan;
        $datasim['update_at'] = date("Y-m-d H:i:s");

        $cekdb = DB::table("siakad_blok.rekap_ajar_dosen")
            ->where("id_pegawai", $id_pegawai)
            ->where("id_semester", $id_semester)
            ->where("id_prodi", $id_prodi)
            ->first();
        if ($cekdb) {
            DB::table("siakad_blok.rekap_ajar_dosen")
                ->where("id_pegawai", $id_pegawai)
                ->where("id_semester", $id_semester)
                ->where("id_prodi", $id_prodi)
                ->update($datasim);
        } else {
            DB::table("siakad_blok.rekap_ajar_dosen")->insert($datasim);
        }
    }
