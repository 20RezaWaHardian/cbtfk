    public function index($ujianId, $pesertaUjianId)
    {
        date_default_timezone_set("Asia/Jakarta"); // mengatur time zone untuk WIB.
        try {
            $ujianId = decrypt($ujianId);
            $pesertaId = decrypt($pesertaUjianId);

            $ujian = Ujian::findorfail($ujianId);

            $peserta = PesertaUjian::with('mahasiswa_rombel')->findorfail($pesertaId);

            if ($peserta->status_pengerjaan == 0) {
                $peserta->update([
                    'mulai_ujian' => Carbon::now(),
                    'status_pengerjaan' => 1,
                    'ip_address' => request()->ip(),
                ]);
            }

            $peserta = PesertaUjian::findorfail($pesertaId);
            $ujian = Ujian::findorfail($ujianId);
            $paket_soal = PaketSoal::where('id_paket_soal',$ujian->paket_soal_id)->first();

            $paket_soal_id = $ujian->paket_soal_id;

            // Ambil nama room yang sudah dibuat oleh admin
            $roomName = $ujian->room_name;

            // Buat URL join khusus peserta ini
            // $idPesertaUjian = $peserta->id_peserta_ujian;
            $participantName = $peserta->mahasiswa_rombel->nama_mahasiswa;
            // $participantUrl = "https://".env('METERED_DOMAIN')."/{$roomName}?name={$participantName}&role=participant&autoJoin=true&id={$peserta->id_peserta_ujian}";
            $participantUrl = env('METERED_DOMAIN')."/{$roomName}";

            $paket_has_soal = PaketHasSoal::where('paket_soal_id', $paket_soal_id)->with('soal')->get();

            $totalSoal = count($paket_has_soal);

            // Jika ada soal yang ditemukan
            if ($paket_has_soal->isNotEmpty()) {
                $soal_ids = $paket_has_soal->pluck('soal_id');
                $soal_satuan = Soal::whereIn('id_soal', $soal_ids)->with(['soal_pilgan','soal_essay','paket_soal'])->orderBy('id_soal', 'asc')->paginate(1);

                $jawaban_pilgan = PilganJawab::where('peserta_ujian_id', $peserta->id_peserta_ujian)
                ->whereIn('soal_id', $soal_ids)
                ->get();

                $jawaban_essay = EssayJawab::where('peserta_ujian_id', $peserta->id_peserta_ujian)
                ->whereIn('soal_id', $soal_ids)
                ->get();

                $totalJawaban = count($jawaban_pilgan) + count($jawaban_essay);

            } else {

                $soal_satuan = collect();
                $jawaban_pilgan = collect();
                $jawaban_essay = collect();

                $totalJawaban = count($jawaban_pilgan) + count($jawaban_essay);


            }

            $jumlahSoal = $soal_satuan->lastPage();



            $waktu_mulai = date('F d, Y H:i:s', strtotime($peserta->mulai_ujian)); // mengubah bentuk string waktu mulai untuk digunakan pada date di js

            $durasi_jam   =  date('H', strtotime($paket_soal->durasi));
            $durasi_menit =  date('i', strtotime($paket_soal->durasi));
            $durasi_detik =  date('s', strtotime($paket_soal->durasi));

            $total_duration_in_seconds = ($durasi_jam * 3600) + ($durasi_menit * 60) + $durasi_detik;

            // waktu selesai = waktu mulai + durasi
            $selesai = date_create($peserta->mulai_ujian);
            date_add($selesai, date_interval_create_from_date_string("$durasi_jam hours, $durasi_menit minutes, $durasi_detik seconds"));
            $waktu_selesai = date_format($selesai, 'Y-m-d H:i:s');

            LogAktifitas::catat("Berhasil Memulai Ujian");
            return view('exam.room.halaman-ujian',
            compact('soal_satuan','ujian',
                    'peserta','paket_soal_id',
                    'waktu_mulai','waktu_selesai',
                    'durasi_jam','durasi_menit',
                    'totalSoal','totalJawaban',
                    'durasi_detik','jawaban_pilgan',
                    'jawaban_essay','jumlahSoal',
                    'total_duration_in_seconds','participantUrl', 'participantName'));

        } catch (\Exception $e) {
            LogAktifitas::catat("Gagal Memulai Ujian");
            return redirect()->back()->with('error','Ops, Ada Kesalahan ... Silahkan Coba Lagi!');
        }
    }


     public function fetch_data(Request $request){

        $peserta = PesertaUjian::find($request->peserta_ujian_id);

