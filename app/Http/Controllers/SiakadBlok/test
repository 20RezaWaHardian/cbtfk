        $dsn = DB::table("siakad_blok.dosen_pengampu")
            ->where("id_kelompok_belajar", $r->id_kelompok_belajar)
            ->wherenotnull("id_pegawai")
            ->count();

        if ($dsn > 0) {
            $err = 1;
        }

        if ($err > 0) {
            return response("Masih terdapat $dsn dosen dan $mhs mahasiswa dikelas kosongkan terlebih dahulu dosen dan mahasiswa", 202);
        } else {
            $del = DB::table("siakad_blok.kelompok_belajar")
                ->where("id_kelompok_belajar", $r->id_kelompok_belajar)
                ->delete();

            if ($del) {
                return response($r->nama_kelompok_belajar . " berhasil dihapus", 200);
            }
        }
    }

